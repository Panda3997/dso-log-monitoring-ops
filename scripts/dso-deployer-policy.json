{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployServices",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "s3:*",
        "glue:*",
        "athena:*",
        "cloudtrail:*",
        "config:*",
        "lambda:*",
        "scheduler:*",
        "sns:*",
        "cloudwatch:*",
        "logs:*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageDsoRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::*:role/dso-*"
    },
    {
      "Sid": "PassDsoRolesToServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/dso-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "config.amazonaws.com",
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    }
  ]
}
